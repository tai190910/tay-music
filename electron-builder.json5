/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.taymusic.pc",
  productName: "Tày Music",
  copyright: "Copyright © 2026 Tày Music",
  directories: {
    output: "release",
    buildResources: "build"
  },
  files: [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/better-sqlite3/**/*",
    "package.json"
  ],
  extraResources: [
    {
      from: "src/core/solver",
      to: "solver",
      filter: ["**/*"]
    }
  ],
  asar: true,
  asarUnpack: [
    "**/node_modules/better-sqlite3/**"
  ],
  npmRebuild: false,
  win: {
    target: [
      {
        target: "portable",
        arch: ["x64"]
      },
      {
        target: "nsis",
        arch: ["x64"]
      }
    ],
    icon: "build/icon.ico"
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "Tày Music",
    artifactName: "Tay Music Setup ${version}.${ext}"
  },
  portable: {
    artifactName: "Tay Music-${version}-Portable.exe"
  }
}
